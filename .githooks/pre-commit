#!/usr/bin/env bash
# .githooks/pre-commit
# Blocks commits that would expose blocked personal identifiers.
#
# Checks five layers (in order):
#   1. git config user.name / user.email
#   2. GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL   (amend, cherry-pick, rebase)
#   3. GIT_COMMITTER_NAME / GIT_COMMITTER_EMAIL
#   4. OS identity fallback (USERNAME, USERDOMAIN, hostname)
#      — only when git config and env vars are both unset
#   5. Staged file content (added lines only; .githooks/ excluded)
#
# Pattern variable names are intentionally opaque.
# Actual patterns live in .githooks/.blocked (gitignored, never committed).
#
# Activate: git config core.hooksPath .githooks
# Setup:    cp .githooks/.blocked.example .githooks/.blocked
#           (then fill in your own patterns)

set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
BLOCKED_FILE="$HOOKS_DIR/.blocked"

# ── Load patterns ──────────────────────────────────────────────────────────────
if [[ ! -f "$BLOCKED_FILE" ]]; then
  printf '[pre-commit] WARNING: %s not found — identity checks skipped.\n' "$BLOCKED_FILE" >&2
  printf '  Run:  cp %s.example %s\n' "$BLOCKED_FILE" "$BLOCKED_FILE" >&2
  printf '  Then add your own patterns and retry.\n' >&2
  exit 0
fi

# Parse sections from .blocked into two opaque pattern groups (P1, P2).
# Lines starting with # and blank lines are ignored within each section.
_section() {
  local sec="$1"
  awk -v s="$sec" '
    /^\[/ { in_sec = (tolower($0) == "[" tolower(s) "]"); next }
    in_sec && /^[[:space:]]*#/ { next }
    in_sec && /^[[:space:]]*$/ { next }
    in_sec { print }
  ' "$BLOCKED_FILE"
}

P1=$(_section "names"       | paste -sd '|' - || true)
P2=$(_section "identifiers" | paste -sd '|' - || true)

# Combine into one ERE alternation; skip empty groups.
_parts=()
[[ -n "$P1" ]] && _parts+=("$P1")
[[ -n "$P2" ]] && _parts+=("$P2")
_COMBINED=$(IFS='|'; printf '%s' "${_parts[*]:-}")

if [[ -z "$_COMBINED" ]]; then
  printf '[pre-commit] WARNING: %s has no patterns — nothing to check.\n' "$BLOCKED_FILE" >&2
  exit 0
fi

FAIL=0

# ── Identity checker ───────────────────────────────────────────────────────────
_block() {
  local label="$1" value="$2"
  [[ -z "$value" ]] && return 0
  if printf '%s' "$value" | grep -qiE "$_COMBINED"; then
    printf '[pre-commit] BLOCKED (%s): a blocked identifier was detected.\n' "$label" >&2
    printf '  Suggested fix:\n' >&2
    printf '    git config user.name "Developer"\n' >&2
    printf '    git config user.email "handle@users.noreply.github.com"\n' >&2
    FAIL=1
  fi
}

# Layer 1 — git config
_block "user.name"  "$(git config user.name  2>/dev/null || true)"
_block "user.email" "$(git config user.email 2>/dev/null || true)"

# Layer 2 — GIT_AUTHOR_*  (set by amend / cherry-pick / rebase)
_block "GIT_AUTHOR_NAME"    "${GIT_AUTHOR_NAME:-}"
_block "GIT_AUTHOR_EMAIL"   "${GIT_AUTHOR_EMAIL:-}"

# Layer 3 — GIT_COMMITTER_*
_block "GIT_COMMITTER_NAME"  "${GIT_COMMITTER_NAME:-}"
_block "GIT_COMMITTER_EMAIL" "${GIT_COMMITTER_EMAIL:-}"

# Layer 4 — OS fallback (only when both git config and env vars are unset)
_git_name="$(git config user.name 2>/dev/null || true)"
if [[ -z "$_git_name" && -z "${GIT_AUTHOR_NAME:-}" && -z "${GIT_COMMITTER_NAME:-}" ]]; then
  _block "OS username"  "${USERNAME:-$(whoami 2>/dev/null || true)}"
  _block "OS domain"    "${USERDOMAIN:-}"
  _block "OS hostname"  "${COMPUTERNAME:-$(hostname 2>/dev/null || true)}"
fi

# Layer 5 — Staged file content (added lines only)
# .githooks/ is excluded: the hook mechanism itself references pattern strings;
# scanning it would self-trigger on the variable names used as grep targets.
while IFS= read -r _file; do
  [[ "$_file" == .githooks/* ]] && continue

  if git diff --cached --unified=0 -- "$_file" \
       | grep '^[+][^+]' \
       | grep -qiE "$_COMBINED"; then
    printf '[pre-commit] BLOCKED (%s): staged content contains a blocked value.\n' "$_file" >&2
    FAIL=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

[[ $FAIL -eq 0 ]] || exit 1
