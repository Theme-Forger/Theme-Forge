#!/usr/bin/env bash
# .githooks/pre-push
# Blocks annotated tags whose tagger line or message body contains a blocked
# personal identifier.  Lightweight tags are skipped (they carry no identity
# metadata of their own — the underlying commit was already checked at commit
# time by pre-commit).
#
# Git calls this hook with the remote name and URL on argv and the list of
# refs being pushed on stdin:  <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# Pattern variable names are intentionally opaque.
# Actual patterns live in .githooks/.blocked (gitignored, never committed).

set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
BLOCKED_FILE="$HOOKS_DIR/.blocked"

[[ ! -f "$BLOCKED_FILE" ]] && exit 0  # No patterns — skip silently.

# Parse the same two opaque groups used by pre-commit and commit-msg.
_section() {
  local sec="$1"
  awk -v s="$sec" '
    /^\[/ { in_sec = (tolower($0) == "[" tolower(s) "]"); next }
    in_sec && /^[[:space:]]*#/ { next }
    in_sec && /^[[:space:]]*$/ { next }
    in_sec { print }
  ' "$BLOCKED_FILE"
}

P1=$(_section "names"       | paste -sd '|' - || true)
P2=$(_section "identifiers" | paste -sd '|' - || true)

_parts=()
[[ -n "$P1" ]] && _parts+=("$P1")
[[ -n "$P2" ]] && _parts+=("$P2")
_COMBINED=$(IFS='|'; printf '%s' "${_parts[*]:-}")

[[ -z "$_COMBINED" ]] && exit 0

FAIL=0

while read -r local_ref _ remote_ref _; do
  # Skip deletions (no object to inspect).
  [[ "$local_ref" == "(delete)" ]] && continue

  # Only care about refs/tags/*.
  [[ "$remote_ref" != refs/tags/* ]] && continue

  tag_name="${remote_ref#refs/tags/}"

  # Resolve the object type.  Fails gracefully if the ref is unknown.
  obj_type=$(git cat-file -t "$local_ref" 2>/dev/null) || continue

  # Lightweight tags point directly to a commit — no tag object, nothing to scan.
  [[ "$obj_type" != "tag" ]] && continue

  # Read the full tag object: header lines (type / tag / tagger) + blank + message.
  tag_content=$(git cat-file tag "$local_ref" 2>/dev/null) || continue

  if printf '%s' "$tag_content" | grep -qiE "$_COMBINED"; then
    printf '[pre-push] BLOCKED: annotated tag %q contains a blocked identifier.\n' "$tag_name" >&2
    printf '  The tagger identity or tag message matched a blocked pattern.\n' >&2
    printf '  Fix:\n' >&2
    printf '    git tag -d %q\n' "$tag_name" >&2
    printf '    (set a clean git identity, then recreate the tag)\n' >&2
    FAIL=1
  fi
done

[[ $FAIL -eq 0 ]] || exit 1
